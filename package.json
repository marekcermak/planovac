{
  "name": "planovac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "icons": "pwa-assets-generator",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --remote --schema public > src/lib/database.types.ts",
    "db:test": "supabase db query --remote --yes -f supabase/tests/rls_phase1.sql && supabase db query --remote --yes -f supabase/tests/rls_phase2.sql && supabase db query --remote --yes -f supabase/tests/rls_phase4.sql && supabase db query --remote --yes -f supabase/tests/rls_phase4b.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
